<Window x:Class="Shottr.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Shottr.Controls"
        Title="Shottr settings"
        Width="600" SizeToContent="Height" ResizeMode="NoResize"
        Icon="pack://application:,,,/Assets/shottr.ico"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,0,0,20" />
        </Style>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="24,20,24,20">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" MinWidth="96" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click" />
            <Button Content="Save" MinWidth="96" IsDefault="True" Click="Save_Click" Style="{DynamicResource AccentButtonStyle}" />
        </StackPanel>

        <StackPanel>
            <TextBlock Text="Shortcuts" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="230" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Capture region" Style="{StaticResource RowLabel}" />
                        <c:HotkeyBox x:Name="RegionHotkey" Grid.Column="1" />
                    </Grid>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="230" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Capture active window" Style="{StaticResource RowLabel}" />
                        <c:HotkeyBox x:Name="WindowHotkey" Grid.Column="1" />
                    </Grid>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="230" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Capture full screen" Style="{StaticResource RowLabel}" />
                        <c:HotkeyBox x:Name="FullScreenHotkey" Grid.Column="1" />
                    </Grid>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                               Text="Click a box and press the keys you want. Backspace clears a shortcut." />

                    <Border x:Name="PrintScreenWarning" Margin="0,12,0,0" Padding="12,10" CornerRadius="6"
                            Background="{DynamicResource SystemFillColorCautionBackgroundBrush}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Let Shottr use it" Margin="12,0,0,0"
                                    VerticalAlignment="Center" Click="FixPrintScreen_Click" />
                            <TextBlock Style="{StaticResource Hint}" FontSize="13" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       Text="Windows is set to open Snipping Tool when you press Print Screen, so Shottr may not receive the key." />
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Border>

            <TextBlock Text="Saving" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Captures folder" Style="{StaticResource RowLabel}" Margin="0,0,0,6" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Browse…" Margin="8,0,0,0" Click="Browse_Click" />
                        <TextBox x:Name="FolderBox" />
                    </DockPanel>

                    <TextBlock Text="File name" Style="{StaticResource RowLabel}" Margin="0,14,0,6" />
                    <TextBox x:Name="PatternBox" TextChanged="PatternBox_TextChanged" />
                    <TextBlock x:Name="PatternPreview" Style="{StaticResource Hint}" Margin="0,6,0,0" />

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="230" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Format" Style="{StaticResource RowLabel}" />
                        <ComboBox x:Name="FormatBox" Grid.Column="1" SelectionChanged="FormatBox_SelectionChanged">
                            <ComboBoxItem Content="PNG (lossless)" />
                            <ComboBoxItem Content="JPEG (smaller files)" />
                        </ComboBox>
                    </Grid>
                    <Grid x:Name="QualityRow" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="JPEG quality" Style="{StaticResource RowLabel}" />
                        <Slider x:Name="QualitySlider" Grid.Column="1" Minimum="40" Maximum="100" TickFrequency="1"
                                IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=QualitySlider, StringFormat={}{0:0}}"
                                   Style="{StaticResource RowLabel}" HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Text="Capture and editor" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="230" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Full screen captures" Style="{StaticResource RowLabel}" />
                        <ComboBox x:Name="FullScreenBox" Grid.Column="1">
                            <ComboBoxItem Content="The monitor under the mouse" />
                            <ComboBoxItem Content="All monitors" />
                        </ComboBox>
                    </Grid>
                    <CheckBox x:Name="MagnifierCheck" Content="Show a magnifier while selecting a region" Margin="0,10,0,0" />
                    <CheckBox x:Name="CloseAfterCopyCheck" Content="Close the editor after copying" Margin="0,6,0,0" />
                    <CheckBox x:Name="StartupCheck" Content="Start Shottr when I sign in to Windows" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <TextBlock Text="Updates" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="VersionText" Style="{StaticResource RowLabel}" />
                        <Button x:Name="CheckUpdatesButton" Grid.Column="1" Content="Check for Updates…" MinWidth="150"
                                Click="CheckUpdates_Click" />
                    </Grid>
                    <CheckBox x:Name="AutoUpdateCheck" Content="Check for updates automatically once a day" Margin="0,10,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </DockPanel>
</Window>
